# Copia este archivo como .env en la raíz del repo.
# El backend lee este mismo .env (spring.config.import en application.properties),
# y docker compose lo usa para crear MySQL. No subas el .env real a Git.
#
# MySQL: MYSQL_PASSWORD (contenedor) y DB_PASSWORD (backend) deben tener el MISMO valor.
MYSQL_ROOT_PASSWORD=cambia_esta_clave
MYSQL_DATABASE=canela_miel
MYSQL_USER=canela
MYSQL_PASSWORD=cambia_esta_clave

# Conexión del backend. Si cambias MYSQL_DATABASE o MYSQL_USER, ajusta DB_URL y DB_USER.
DB_URL=jdbc:mysql://localhost:3306/canela_miel?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=canela
DB_PASSWORD=cambia_esta_clave

# Clave para firmar los tokens (mínimo 32 caracteres). Es obligatoria: sin ella el backend no arranca.
JWT_SECRET=cambia_esta_clave_larga_para_firmar_los_tokens_2026

# Opcionales (si no están, se usan los valores indicados)
# SERVER_PORT=8080
# JWT_ACCESS_MINUTOS=15
# JWT_REFRESH_DIAS=7
